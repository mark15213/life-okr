POSTGRES_URL="your-postgres-url"
POSTGRES_PRISMA_URL="your-prisma-url"
POSTGRES_URL_NON_POOLING="your-non-pooling-url"
POSTGRES_USER="your-user"
POSTGRES_HOST="your-host"
POSTGRES_PASSWORD="your-password"
POSTGRES_DATABASE="your-database"

# Dashboard write access (required in production)
DASHBOARD_PASSCODE="change-me"
DASHBOARD_AUTH_SECRET="generate-with: openssl rand -hex 32"

# Token usage reporter (local Mac → /api/tokens)
DASHBOARD_URL="http://localhost:3000"
TOKEN_REPORT_SECRET="generate-with: openssl rand -hex 32"

# TickTick sync (scripts/sync-ticktick.ts)
# Tasks + focus both come from TickTick's unofficial cookie API (the official
# /open/v1 endpoint excludes Inbox). Email+password are used as a fallback for
# initial cookie acquisition only — for Google-OAuth accounts, you must instead
# write the browser `t=` cookie to .ticktick-session.json directly.
TICKTICK_EMAIL="your-ticktick-account-email"
TICKTICK_PASSWORD="your-ticktick-account-password"

# TickTick tasks panel (the web app, not the sync script)
# The browser `t=` cookie, as either `t=abc123` or the bare token. Required in production:
# .ticktick-session.json is gitignored and never reaches Vercel, so without this the panel
# returns 503. Expires roughly every six months — re-copy it from a logged-in browser.
TICKTICK_COOKIE="t=your-ticktick-session-cookie"
