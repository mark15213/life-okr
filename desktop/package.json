{
  "name": "hustle-desktop",
  "version": "0.1.0",
  "description": "Hustle desktop focus timer",
  "author": "Hustle",
  "private": true,
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.mjs",
    "test:smoke": "node tests/smoke.cjs",
    "pack": "electron-builder --dir",
    "dist:win": "electron-builder --win nsis --x64",
    "dist:zip": "electron-builder --win zip --x64",
    "dist:mac": "electron-builder --mac dmg --arm64"
  },
  "devDependencies": {
    "electron": "^44.3.0",
    "electron-builder": "^26.0.12",
    "playwright": "^1.58.0"
  },
  "build": {
    "appId": "com.lifeokr.hustle",
    "productName": "Hustle",
    "directories": { "output": "release" },
    "files": ["main.cjs", "preload.cjs", "engine.mjs", "storage.cjs", "renderer/**"],
    "asar": true,
    "win": { "target": [{ "target": "nsis", "arch": ["x64"] }] },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true },
    "mac": { "target": [{ "target": "dmg", "arch": ["arm64"] }], "category": "public.app-category.productivity" }
  }
}
